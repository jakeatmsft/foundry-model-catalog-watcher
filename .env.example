# Comma-separated values. Copy this file to .env and save your filters there.
REGIONS=eastus2

# Match model.format. Leave blank for all providers.
# Example: OpenAI,Anthropic,Microsoft,Mistral AI
PROVIDERS=

# Match any model.skus[].name. Leave blank for all deployment types.
# Example: GlobalStandard,DataZoneStandard,Standard,GlobalBatch
DEPLOYMENT_TYPES=

# Relative state paths resolve beside watch_foundry_models.py.
STATE_PATH=model-watch-state.json

# Optional alerts. These are only sent when new models appear after the first run.
WEBHOOK_URL=
EMAIL_TO=
QUIET=false
